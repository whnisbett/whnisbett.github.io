---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.filter((p) => p.data.featured);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Writing" description="Essays on ML systems in small companies and on leading engineers.">
  <h1>Writing</h1>

  <figure>
    <img src="/images/writing.svg" alt="" width="1200" height="800" />
    <figcaption>Replace with a painting you like. This caption is where you say why.</figcaption>
  </figure>

  <p>Mostly two threads: building machine learning systems when the team is small and the data is messy, and what it is actually like to lead engineers. Occasionally physics, Chinese, or whatever I'm reading.</p>

  {featured.length > 0 && (
    <>
      <h2>Start here</h2>
      <ul class="posts">
        {featured.map((p) => (
          <li><span class="date">{fmt(p.data.date)}</span><a href={`/writing/${p.id}`}>{p.data.title}</a></li>
        ))}
      </ul>
    </>
  )}

  <h2>All posts</h2>
  <ul class="posts">
    {all.map((p) => (
      <li><span class="date">{fmt(p.data.date)}</span><a href={`/writing/${p.id}`}>{p.data.title}</a></li>
    ))}
  </ul>
  <p class="sub"><a href="/rss.xml">rss</a></p>
</Base>
