---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.filter((p) => p.data.featured);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="Writing" description="Writing by William Nisbett.">
  <h1>Writing</h1>

  {featured.length > 0 && (
    <>
      <h2>Start here</h2>
      <ul class="posts">
        {featured.map((p) => (
          <li><span class="date">{fmt(p.data.date)}</span><a href={`/writing/${p.id}`}>{p.data.title}</a></li>
        ))}
      </ul>
    </>
  )}

  {all.length === 0 && <p>Work in progress.</p>}

  {all.length > 0 && <h2>All posts</h2>}
  {all.length > 0 && <ul class="posts">
    {all.map((p) => (
      <li><span class="date">{fmt(p.data.date)}</span><a href={`/writing/${p.id}`}>{p.data.title}</a></li>
    ))}
  </ul>}
  <p class="sub"><a href="/rss.xml">rss</a></p>
</Base>
